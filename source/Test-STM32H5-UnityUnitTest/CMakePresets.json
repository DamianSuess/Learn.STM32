{
  "version": 3,
  "configurePresets": [
    {
      "name": "default",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "${sourceDir}/cmake/gcc-arm-none-eabi.cmake",
      "cacheVariables": {}
    },
    {
      "name": "Debug",
      "displayName": "Debug Build Presets",
      "inherits": "default",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ENABLE_UNIT_TESTING": "OFF"
      }
    },
    {
      "name": "Release",
      "displayName": "Release Build Presets",
      "inherits": "default",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "ENABLE_UNIT_TESTING": "OFF"
      }
    },
    {
      "name": "Debug-Test",
      "displayName": "Debug build with Unit Tests enabled",
      "description": "Configuration with tests enabled",
      "inherits": "default",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ENABLE_UNIT_TESTING": "ON",
        "ENABLE_COVERAGE": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "Debug",
      "displayName": "Debug Build",
      "configurePreset": "Debug"
    },
    {
      "name": "Release",
      "displayName": "Release Build",
      "configurePreset": "Release"
    },
    {
      "name": "Test",
      "displayName": "Unit Test Build",
      "configurePreset": "Debug-Test"
    }
  ],
  "testPresets": [
    {
      "name": "Test",
      "description": "Test Preset",
      "displayName": "Test Preset",
      "configurePreset": "Debug-Test"
    }
  ]
}